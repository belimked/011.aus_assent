[Unit]
Description=Backup Axleo SQLite database

[Service]
Type=oneshot
User=axleo
Group=axleo
EnvironmentFile=/etc/axleo/env
ExecStart=/bin/bash -euc '/opt/axleo/current/axleo backup /data/axleo/backup; ls -1t /data/axleo/backup/axleo-*.db | tail -n +15 | xargs -r rm --'
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/axleo
PrivateTmp=true
