[Unit]
Description=Backup Axleo SQLite database

[Service]
Type=oneshot
User=axleo
Group=axleo
EnvironmentFile=/etc/axleo/env
ExecStart=/bin/bash -euc 'mkdir -p /data/axleo/backup; sqlite3 "$$AXLEO_DB" ".backup /data/axleo/backup/axleo-$$(date +%%Y%%m%%d-%%H%%M%%S).db"; ls -1t /data/axleo/backup/axleo-*.db | tail -n +15 | xargs -r rm --'
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/axleo
PrivateTmp=true
