[Unit]
Description=AxleoCollect API
After=network.target

[Service]
Type=simple
User=axleo
Group=axleo
EnvironmentFile=/etc/axleo/env
WorkingDirectory=/data/axleo
ExecStart=/opt/axleo/current/axleo serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/axleo
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
