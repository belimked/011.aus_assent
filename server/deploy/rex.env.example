# Add to the protected /etc/axleo/env only after approving the Rex account.
# No Rex calls until all five REX_* credentials/account values are present.
AXLEO_REX_READ=0
AXLEO_REX_WRITE=0
# Must equal REX_ACCOUNT_ID to start the worker.
REX_WRITE_ACCOUNT_ID=
REX_BASE_URL=https://api.rexsoftware.com
REX_APP_ID=Integration:PlaceSunnybank:Portal
REX_EMAIL=CHANGE_ME
REX_PASSWORD=CHANGE_ME
# Explicit target: 2057 shared sandbox; 758 Place Sunnybank production. No default.
REX_ACCOUNT_ID=
REX_INTERVAL_MS=1200
