# Add to the protected /etc/axleo/env only after approving the Rex account.
# No Rex calls until all five REX_* credentials/account values are present.
AXLEO_REX_READ=0
AXLEO_REX_WRITE=0
# Must equal REX_ACCOUNT_ID to start the worker.
REX_WRITE_ACCOUNT_ID=
REX_BASE_URL=https://api.rexsoftware.com
REX_APP_ID=Integration:PlaceSunnybank:Portal
REX_EMAIL=CHANGE_ME
REX_PASSWORD=CHANGE_ME
# Explicit target: 2057 shared sandbox; 758 Place Sunnybank production. No default.
REX_ACCOUNT_ID=
REX_INTERVAL_MS=1200
# Write requires AXLEO_REX_WRITE=1, REX_WRITE_ACCOUNT_ID=2057 and successful active-account verification.
# Defaults to 2057; never set to empty. 758 additionally requires REX_ALLOW_PRODUCTION_WRITE=1.
REX_WRITE_ALLOWED_ACCOUNTS=2057
# Polling requires AXLEO_REX_READ=1; 60 seconds, minimum 30; set 0 to disable soft deletion.
REX_POLL_SECONDS=60
# Relationship-only edits might not change search etags. Re-read up to 500 recently updated properties every 10 minutes (minimum 60s).
REX_RELATION_REFRESH_SECONDS=600
# Map Rex system_owner_user id or email to enabled Axleo user email; fallback for unmapped new records.
REX_USER_MAP=80559:mary@axleo.local
REX_DEFAULT_OWNER_EMAIL=mary@axleo.local
REX_POLL_SOFT_DELETE=1
