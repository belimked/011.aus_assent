# Copy values into /etc/axleo/env (root:axleo, mode 0640). Do not commit credentials.
AXLEO_ADDR=127.0.0.1:8082
AXLEO_DB=/data/axleo/db/axleo.db
AXLEO_BACKUP_DIR=/data/axleo/backup
AXLEO_SEED_PASSWORD=CHANGE_ME_BEFORE_SEED
# Used by STT and TTS (/api/v1/stt/transcribe and /api/v1/tts).
AXLEO_AZURE_SPEECH_KEY=CHANGE_ME
AXLEO_AZURE_SPEECH_REGION=australiaeast
# Used by extraction and translation (/api/v1/ai/extract and /api/v1/ai/translate).
# Model must start with au.
AXLEO_BEDROCK_API_KEY=CHANGE_ME
AXLEO_BEDROCK_REGION=ap-southeast-2
AXLEO_BEDROCK_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
